---
import MiniPlate from './MiniPlate.astro';

const ficha = [
  { k: 'Alcance', v: 'Solo sitios que ya existen' },
  { k: 'Método', v: 'Diagnóstico, dirección, relanzamiento' },
  { k: 'Resultado', v: 'La misma empresa, otra primera impresión' },
];
---

<section
  id="top"
  class="relative flex min-h-svh flex-col justify-between pt-[7rem] pb-8 md:pt-[8.5rem] xl:pt-[10rem]"
>
  <div class="shell w-full">
    <div class="flex items-baseline justify-between gap-6 border-b border-line pb-5">
      <p class="ficha text-walnut">Relanza Web — Estudio de relanzamiento digital</p>
      <p class="ficha hidden text-ink-soft sm:block">Tu negocio evolucionó</p>
    </div>

    <h1 class="hero-plate mt-9 md:mt-12">
      <span class="hero-now display-lg block">
        Tu empresa ya cambió.<br />Falta que se note.
      </span>
      <span class="hero-then block" aria-hidden="true">
        Tu empresa ya cambió. Falta que se note.
        <em class="mt-1 block text-[0.55em] font-normal no-underline"
          >¡Bienvenidos a nuestra página web!</em
        >
      </span>
      <span class="hero-seam" aria-hidden="true"></span>
    </h1>

    <div
      class="mt-10 grid items-start gap-12 md:mt-12 md:grid-cols-[minmax(0,1fr)_minmax(0,0.78fr)] md:gap-16 xl:gap-24"
    >
      <div>
        <p class="lede text-ink-soft">
        Relanzamos la imagen digital de negocios que hoy valen mucho más de lo que su sitio web
        comunica. No cambiamos lo que dices: cambiamos cuánto se te cree cuando lo dices.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#contacto-form" class="btn-base btn-solid">
          Solicitar diagnóstico
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path
              d="M1 5h11M8.5 1.5 12 5l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="#comparador" class="btn-base btn-line">Ver una transformación</a>
      </div>
      <p class="ficha mt-5 text-ink-soft">
        Diagnóstico gratuito · respuesta en 24 h hábiles · sin compromiso
      </p>
      </div>

      <figure class="mini-card group hidden w-full max-w-[27rem] justify-self-end md:block" data-reveal>
        <MiniPlate class="aspect-[16/10]" />
        <figcaption class="ficha mt-4 flex items-center gap-3 text-ink-soft">
          <span class="h-px w-8 shrink-0 bg-brass" aria-hidden="true"></span>
          El mismo negocio, dos primeras impresiones
        </figcaption>
      </figure>
    </div>
  </div>

  <div class="shell mt-14 w-full md:mt-20">
    <div class="grid border-t border-line sm:grid-cols-3">
      {
        ficha.map((f, i) => (
          <div
            class:list={[
              'py-5 sm:py-6',
              i > 0 && 'border-t border-line sm:border-t-0 sm:border-l sm:pl-6 md:pl-8',
            ]}
            data-reveal
          >
            <p class="ficha text-ink-soft">{f.k}</p>
            <p class="mt-2.5 text-[0.9375rem] leading-snug tracking-[-0.012em]">{f.v}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
